ENVIRONMENT=development
LOG_LEVEL=INFO

GEMINI_API_KEY=your-gemini-api-key-here
# gemini-3.8-flash is the documented Phase 1 choice (Decision 1) and the
# code default. On the free tier the lite models are rationed hard and
# answer 503 far more often, so do not point this at one.
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the primary model is overloaded (503) or rate-limited
# (429). JSON list, same as CORS_ORIGINS.
GEMINI_FALLBACK_MODELS=["gemini-3.6-flash","gemini-3.5-flash-lite"]

# Declared for Phase 2; no code reads it yet, so no database is needed to run.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/save_organize

CORS_ORIGINS=["*"]

# Managed hosts (Render, Railway, Cloud Run) set this themselves; the
# container falls back to 8000 when it is absent.
# PORT=8000
